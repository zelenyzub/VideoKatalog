@model IEnumerable<VideoKlub.ViewModels.Reports.AvgRatingByCategoryReportVM>
<div class="container mt-5">
    <div class="card card-flush">
        <div class="card-header">
            <h3 class="card-title">Prosečne ocene po kategorijama</h3>
        </div>

        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Kategorija</th>
                        <th class="text-end">Prosečna ocena</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryName</td>
                            <td class="text-end">@item.AverageRating.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>