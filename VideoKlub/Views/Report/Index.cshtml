<div class="container mt-5">
    <div class="card card-flush shadow-sm">
        <div class="card-header">
            <h3 class="card-title fw-bold">
                <i class="ki-solid ki-chart-simple-2 fs-2 me-2"></i>
                Pregled izveštaja
            </h3>
        </div>

        <div class="card-body pt-0">
            <div class="list-group list-group-flush">
                <a asp-action="Popular"
                   class="list-group-item list-group-item-action d-flex align-items-center py-4">
                    <i class="ki-solid ki-star fs-2 text-warning me-4"></i>
                    <div>
                        <div class="fw-bold">Najpopularniji sadržaji</div>
                        <div class="text-muted fs-7">
                            Sadržaji sa najvećim brojem favorita
                        </div>
                    </div>
                </a>

                <a asp-action="TopRated"
                   class="list-group-item list-group-item-action d-flex align-items-center py-4">
                    <i class="ki-solid ki-like fs-2 text-success me-4"></i>
                    <div>
                        <div class="fw-bold">Najbolje ocenjeni sadržaji</div>
                        <div class="text-muted fs-7">
                            Najviša prosečna ocena
                        </div>
                    </div>
                </a>

                <a asp-action="AvgByCategory"
                   class="list-group-item list-group-item-action d-flex align-items-center py-4">
                    <i class="ki-solid ki-category fs-2 text-primary me-4"></i>
                    <div>
                        <div class="fw-bold">Prosečne ocene po kategorijama</div>
                        <div class="text-muted fs-7">
                            Analiza kvaliteta po kategorijama
                        </div>
                    </div>
                </a>

                <a asp-action="UserActivity"
                   class="list-group-item list-group-item-action d-flex align-items-center py-4">
                    <i class="ki-solid ki-profile-circle fs-2 text-info me-4"></i>
                    <div>
                        <div class="fw-bold">Aktivnost korisnika</div>
                        <div class="text-muted fs-7">
                            Broj ocena i favorita po korisniku
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>