@model IEnumerable<VideoKlub.Models.Video>
@inject VideoKlub.Repositories.Interfaces.ICategoryRepository CategoryRepository;

@{
    var categories = await CategoryRepository.GetAllAsync();
}

@if (ViewData["SearchQuery"] != null)
{
    @* SEARCH RESULTS *@
    @if (!Model.Any())
    {
        <div class="mb-8">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">Nema rezultata za: <span class="text-primary">"@ViewData["SearchQuery"]"</span></h3>
                    <p class="text-muted fs-6 mt-2">Pokušajte sa drugačijim ključnom rečju ili pregledajte sve dostupne sadržaje</p>
                </div>
                <div>
                    <a href="@Url.Action("Index", "Video")" class="btn btn-light-primary btn-sm">
                        <i class="ki-outline ki-arrow-left"></i>
                        Svi sadržaji
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mb-8">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">Rezultati pretrage za: <span class="text-primary">"@ViewData["SearchQuery"]"</span></h3>
                    <p class="text-muted fs-6 mt-2">Pronađeno je <span class="fw-bold text-primary">@Model.Count()</span> rezultata koji odgovaraju vašoj pretrazi</p>
                </div>
                <div>
                    <a href="@Url.Action("Index", "Video")" class="btn btn-light-primary btn-sm">
                        <i class="ki-outline ki-arrow-left"></i>
                        Nazad na početak
                    </a>
                </div>
            </div>
        </div>

        <div class="row g-6">
            @foreach (var v in Model)
            {
                <div class="col-xl-2 col-lg-2 col-md-3 col-sm-4 col-6">
                    <div class="card card-flush h-100 video-card hover-scale shadow-sm position-relative">
                        <div class="card-body p-0">
                            <div class="overlay-wrapper">
                                <img src="~/@v.ImagePath"
                                     class="w-100 rounded"
                                     style="height:260px; object-fit:cover;" />
                            </div>
                        </div>
                        <div class="card-footer px-3 py-2 d-flex align-items-center gap-2" style="min-height:80px;">
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="fw-bold text-gray-900 text-truncate" style="min-width:0;">
                                    @v.Title
                                </div>
                                <div class="text-muted fs-7 text-truncate" style="min-width:0;">
                                    @v.Category.Name
                                </div>
                            </div>
                            <form asp-controller="Favorite" asp-action="Toggle" method="post" class="m-0 flex-shrink-0" style="position:relative; z-index:2;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="videoId" value="@v.Id" />
                                <button type="submit" class="btn btn-icon btn-sm btn-light-danger shadow-sm">
                                    @if (v.IsFavorite)
                                    {
                                        <i class="ki-solid ki-heart fs-2 text-danger"></i>
                                    }
                                    else
                                    {
                                        <i class="ki-outline ki-heart fs-2 text-danger"></i>
                                    }
                                </button>
                            </form>
                        </div>
                        <a asp-controller="Video" asp-action="Details" asp-route-id="@v.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @* DEFAULT VIDEO LIST + FILTER *@
    @if (!Model.Any())
    {
        @if (ViewData["FilterActive"] != null)
        {
            <div class="mb-8">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">Nema sadržaja u izabranim kategorijama</h3>
                        <p class="text-muted fs-6 mt-2">
                            Pokušajte sa drugim kategorijama ili se vratite na kompletan katalog
                        </p>
                    </div>
                    <div>
                        <a href="@Url.Action("Index", "Video")" class="btn btn-light-primary btn-sm">
                            <i class="ki-outline ki-arrow-left"></i>
                            Svi sadržaji
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                Trenutno nema dostupnih video sadržaja.
            </div>
        }
    }
    else
    {
        @* FILTER BY CATEGORIES *@
        <div class="mb-8">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (ViewData["PageHeading"] != null)
                    {
                        <h3 class="mb-0">@ViewData["PageHeading"]</h3>
                        <p class="text-muted fs-6 mt-2">@ViewData["PageSubheading"]</p>
                    }
                    else
                    {
                        <h3 class="mb-0">Pronađite svoj omiljeni video sadržaj</h3>
                        <p class="text-muted fs-6 mt-2">
                            Dostupno je <span class="fw-bold text-primary">@Model.Count()</span> video sadržaja
                        </p>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light-primary dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside">
                            <i class="ki-outline ki-filter-search fs-1"></i>
                            Filtriraj po kategoriji
                        </button>

                        <div class="dropdown-menu p-4 w-250px">
                            <form method="get"
                                  asp-controller="Video"
                                  asp-action="FilterByCategory">

                                <div class="mb-3">
                                    <select name="categoryIds"
                                            class="form-select form-select-solid form-select-sm cursor-pointer"
                                            multiple
                                            data-control="select2"
                                            data-placeholder="Izaberite kategorije">
                                        @foreach (var c in categories)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="text-muted fs-8 mb-3">
                                    Možete izabrati više kategorija
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    <button type="submit"
                                            class="btn btn-light-primary btn-sm w-100">
                                        <i class="ki-outline ki-magnifier fs-2"></i>
                                        Primeni filter
                                    </button>

                                    <a href="@Url.Action("Index", "Video")"
                                       class="btn btn-light-danger btn-sm w-100">
                                        <i class="ki-outline ki-cross-square fs-2"></i>
                                        Resetuj
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* VIDEO CARDS *@
        <div class="row g-6">
            @foreach (var v in Model)
            {
                <div class="col-xl-2 col-lg-2 col-md-3 col-sm-4 col-6">
                    <div class="card card-flush h-100 video-card hover-scale shadow-sm position-relative">
                        <div class="card-body p-0">
                            <div class="overlay-wrapper">
                                <img src="~/@v.ImagePath"
                                     class="w-100 rounded"
                                     style="height:260px; object-fit:cover;" />
                            </div>
                        </div>
                        <div class="card-footer px-3 py-2 d-flex align-items-center gap-2" style="min-height:80px;">
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="fw-bold text-gray-900 text-truncate" style="min-width:0;">
                                    @v.Title
                                </div>
                                <div class="text-muted fs-7 text-truncate" style="min-width:0;">
                                    @v.Category.Name
                                </div>
                            </div>
                            <form asp-controller="Favorite" asp-action="Toggle" method="post" class="m-0 flex-shrink-0" style="position:relative; z-index:2;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="videoId" value="@v.Id" />
                                <button type="submit" class="btn btn-icon btn-sm btn-light-danger shadow-sm">
                                    @if (v.IsFavorite)
                                    {
                                        <i class="ki-solid ki-heart fs-2 text-danger"></i>
                                    }
                                    else
                                    {
                                        <i class="ki-outline ki-heart fs-2 text-danger"></i>
                                    }
                                </button>
                            </form>
                        </div>
                        <a asp-controller="Video" asp-action="Details" asp-route-id="@v.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('[data-control="select2"]').select2({
                closeOnSelect: false,
                dropdownParent: $('.dropdown-menu')
            });
        });
    </script>
}
