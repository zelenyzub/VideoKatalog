@model VideoKlub.Models.ForgotPasswordViewModel

<div class="d-flex flex-column flex-root">

    <div class="d-flex flex-column flex-column-fluid justify-content-center align-items-center">

        <div class="w-lg-500px p-10">

            <div class="card shadow-sm">

                <div class="card-body p-10">

                    <div class="text-center mb-10">

                        <h1 class="text-dark fw-bolder mb-3">
                            Zaboravljena šifra
                        </h1>

                        <div class="text-gray-500 fw-semibold fs-6">
                            Unesite email adresu povezanu sa nalogom
                        </div>

                    </div>

                    <form asp-action="ForgotPassword" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-5">
                        </div>

                        <div class="fv-row mb-8">

                            <label class="form-label fw-bold text-dark">
                                Email adresa
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-solid"
                                   placeholder="Unesite email adresu" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-grid mb-5">

                            <button type="submit"
                                    class="btn btn-primary">
                                Pošalji link za resetovanje
                            </button>

                        </div>

                    </form>

                    <div class="text-center">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="link-primary fw-bold">
                            Nazad na prijavu
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>