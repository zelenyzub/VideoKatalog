@model VideoKlub.Models.LoginViewModel

<div class="d-flex flex-column flex-root">

    <div class="d-flex flex-column flex-column-fluid justify-content-center align-items-center">

        <div class="w-lg-500px p-10">

            <div class="card shadow-sm">

                <div class="card-body p-10">

                    <div class="text-center mb-10">

                        <h1 class="text-dark fw-bolder mb-3">
                            Prijava
                        </h1>

                        <div class="text-gray-500 fw-semibold fs-6">
                            Prijavite se na svoj nalog
                        </div>

                    </div>

                    <form asp-action="Login" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-5">
                        </div>

                        <div class="fv-row mb-8">

                            <label class="form-label fw-bold text-dark">
                                Email adresa
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-solid"
                                   placeholder="Unesite email adresu" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>

                        <div class="fv-row mb-5">

                            <label class="form-label fw-bold text-dark">
                                Lozinka
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-solid"
                                   placeholder="Unesite lozinku" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex flex-stack flex-wrap gap-3 fs-base fw-semibold mb-8">

                            <div class="form-check form-check-custom form-check-solid">

                                <input asp-for="RememberMe"
                                       class="form-check-input" />

                                <label asp-for="RememberMe"
                                       class="form-check-label">
                                    Zapamti me
                                </label>

                            </div>

                            <a asp-controller="Account"
                               asp-action="ForgotPassword"
                               class="link-primary">
                                Zaboravili ste šifru?
                            </a>

                        </div>

                        <div class="d-grid mb-8">

                            <button type="submit"
                                    class="btn btn-primary">

                                <span class="indicator-label">
                                    Prijava
                                </span>

                            </button>

                        </div>

                    </form>

                    <div class="separator separator-content my-10">
                        <span class="w-125px text-gray-500 fw-semibold fs-7">
                            ili
                        </span>
                    </div>

                    <div class="text-center">

                        <span class="text-gray-500">
                            Nemate nalog?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="link-primary fw-bold ms-2">
                            Registrujte se
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>