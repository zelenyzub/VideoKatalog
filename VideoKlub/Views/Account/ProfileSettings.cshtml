@model VideoKlub.Models.ProfileSettingsViewModel

<div class="d-flex flex-column flex-root">
    <div class="d-flex flex-column flex-column-fluid justify-content-center align-items-center">
        <div class="w-lg-600px p-10">
            <div class="card shadow-sm">
                <div class="card-body p-10">
                    <div class="text-center mb-10">
                        <h1 class="text-dark fw-bolder mb-3">Podešavanje profila</h1>
                        <div class="text-gray-500 fw-semibold fs-6">Ažurirajte svoje podatke ili obrišite nalog.</div>
                    </div>

                    @if (ViewBag.StatusMessage != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.StatusMessage
                        </div>
                    }

                    <form asp-action="ProfileSettings" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-5"></div>

                        <div class="fv-row mb-8">
                            <label class="form-label fw-bold text-dark">Email adresa</label>
                            <input asp-for="Email" class="form-control form-control-solid" placeholder="Unesite email adresu" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="fv-row mb-8">
                            <label class="form-label fw-bold text-dark">Trenutna lozinka</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control form-control-solid" placeholder="Unesite trenutnu lozinku" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="fv-row mb-8">
                            <label class="form-label fw-bold text-dark">Nova lozinka</label>
                            <input asp-for="NewPassword" type="password" class="form-control form-control-solid" placeholder="Unesite novu lozinku" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="fv-row mb-8">
                            <label class="form-label fw-bold text-dark">Potvrdite novu lozinku</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-solid" placeholder="Potvrdite novu lozinku" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-10">
                            <button type="submit" class="btn btn-primary">Sačuvaj promene</button>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">Obriši nalog</button>
                        </div>
                    </form>

                    <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteAccountModalLabel">Potvrda brisanja naloga</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Ovo je trajna akcija. Nakon brisanja nalog se više ne može vratiti.</p>
                                    <form asp-action="DeleteAccount" method="post">
                                        @Html.AntiForgeryToken()

                                        <div class="fv-row mb-8">
                                            <label class="form-label fw-bold text-dark">Unesite trenutnu lozinku</label>
                                            <input asp-for="CurrentPassword" type="password" class="form-control form-control-solid" placeholder="Potvrdite lozinku" />
                                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                        </div>

                                        <div class="d-flex justify-content-end">
                                            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Otkaži</button>
                                            <button type="submit" class="btn btn-danger">Obriši nalog</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
