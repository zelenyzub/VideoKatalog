@model VideoKlub.Models.ResetPasswordViewModel

<div class="d-flex flex-column flex-root">

    <div class="d-flex flex-column flex-column-fluid justify-content-center align-items-center">

        <div class="w-lg-500px p-10">

            <div class="card shadow-sm">

                <div class="card-body p-10">

                    <div class="text-center mb-10">

                        <h1 class="text-dark fw-bolder mb-3">
                            Nova šifra
                        </h1>

                        <div class="text-gray-500 fw-semibold fs-6">
                            Unesite novu šifru za svoj nalog
                        </div>

                    </div>

                    <form asp-action="ResetPassword" method="post">

                        <input asp-for="Token" type="hidden" />
                        <input asp-for="Email" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-5">
                        </div>

                        <div class="fv-row mb-8">

                            <label class="form-label fw-bold text-dark">
                                Nova šifra
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-solid" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                        </div>

                        <div class="fv-row mb-8">

                            <label class="form-label fw-bold text-dark">
                                Potvrdite šifru
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control form-control-solid" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary">
                                Sačuvaj novu šifru
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>