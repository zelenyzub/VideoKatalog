@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Video katalog</title>

    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=figtree:400,500,600&display=swap" rel="stylesheet" />
    <link href="/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
</head>

<body id="kt_body" class="header-fixed" style="--kt-toolbar-height:55px;">
    <script>
        document.documentElement.setAttribute('data-bs-theme', 'light');
        try { localStorage.setItem('data-bs-theme', 'light'); } catch(e){}
    </script>

    <div class="d-flex flex-column flex-root">
        <div class="page d-flex flex-row flex-column-fluid">
            <div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">

                <!-- HEADER -->
                <div id="kt_header" class="header align-items-stretch">
                    <div class="container-fluid d-flex align-items-stretch justify-content-between">
                        <div class="d-flex align-items-center flex-grow-1">
                            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center me-5">
                                <span class="fw-bold fs-4 text-white">Video katalog</span>
                            </a>
                            @if(User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="header-menu align-items-stretch">
                                    <div class="menu menu-column menu-lg-row menu-active-bg menu-state-primary menu-title-gray-800 menu-arrow-gray-500 align-items-stretch fw-semibold fs-6" id="kt_header_menu" data-kt-menu="true">
                                        <div class="menu-item me-0 me-lg-2">
                                            <a asp-controller="Video" asp-action="Index" class="menu-link px-3 py-2 text-white text-hover-primary">
                                                <span class="menu-title"><i class="ki-solid ki-book fs-2 me-2"></i> Video Katalog</span>
                                            </a>
                                        </div>
                                        <div class="menu-item me-0 me-lg-2">
                                            <a asp-controller="Favorite" asp-action="Index" class="menu-link px-3 py-2 text-white text-hover-primary">
                                                <span class="menu-title"><i class="ki-solid ki-heart fs-2 me-2"></i> Omiljeni Sadržaj</span>
                                            </a>
                                        </div>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div class="menu-item me-0 me-lg-2"
                                                 data-kt-menu-trigger="hover"
                                                 data-kt-menu-placement="bottom-end">

                                                <!-- TOGGLE -->
                                                <a href="#"
                                                   class="menu-link px-3 py-2 text-white text-hover-primary">
                                                    <span class="menu-title">
                                                        <i class="ki-solid ki-security-user fs-2 me-2"></i>
                                                        Admin Options
                                                    </span>
                                                    <span class="menu-arrow"></span>
                                                </a>

                                                <!-- DROPDOWN -->
                                                <div class="menu-sub menu-sub-dropdown menu-rounded menu-gray-800 menu-state-bg fw-semibold py-4 w-250px">

                                                    <!-- ISTAKNUTA OPCIJA -->
                                                    <div class="menu-item px-3">
                                                        <a asp-controller="Dashboard"
                                                           asp-action="Index"
                                                           class="menu-link px-3">
                                                            <span class="menu-icon">
                                                                <i class="ki-solid ki-burger-menu-2 fs-2"></i>
                                                            </span>
                                                            <span class="menu-title">Admin Panel</span>
                                                        </a>
                                                    </div>

                                                    <!-- SEPARATOR -->
                                                    <div class="separator my-2"></div>

                                                    <!-- DRUGA OPCIJA -->
                                                    <div class="menu-item px-3">
                                                        <a asp-controller="Dashboard"
                                                           asp-action="AddVideo"
                                                           class="menu-link px-3">
                                                            <span class="menu-icon">
                                                                <i class="ki-solid ki-plus-circle fs-2"></i>
                                                            </span>
                                                            <span class="menu-title">Dodaj Novi Sadržaj</span>
                                                        </a>
                                                    </div>

                                                    <!-- TREĆA OPCIJA -->
                                                    <div class="menu-item px-3">
                                                        <a asp-controller="Roles"
                                                           asp-action="Index"
                                                           class="menu-link px-3">
                                                            <span class="menu-icon">
                                                                <i class="ki-solid ki-shield fs-2"></i>
                                                            </span>
                                                            <span class="menu-title">Roles</span>
                                                        </a>
                                                    </div>

                                                </div>
                                            </div>

                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <!-- SEARCH VIDEO INPUT -->
                            <form asp-controller="Video" asp-action="Search" method="get" class="d-flex align-items-center position-relative me-3">
                                <input type="text" name="query" class="form-control form-control-solid w-200px" placeholder="Pretraži video..." />
                                <button type="submit" class="btn btn-icon btn-primary ms-2">
                                    <i class="ki-outline ki-magnifier fs-2"></i>
                                </button>
                            </form>

                            <div class="d-flex align-items-stretch">
                                <div class="topbar-item px-3 px-lg-4 cursor-pointer" data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                                    <i class="ki-outline ki-night-day theme-light-show fs-1"></i>
                                    <i class="ki-outline ki-moon theme-dark-show fs-1"></i>
                                </div>
                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-title-gray-700 menu-icon-gray-500 menu-active-bg menu-state-color fw-semibold py-4 fs-base w-150px" data-kt-menu="true" data-kt-element="theme-mode-menu">
                                    <div class="menu-item px-3 my-0">
                                        <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="light">
                                            <span class="menu-icon"><i class="ki-outline ki-night-day fs-2"></i></span>
                                            <span class="menu-title">Svetlo</span>
                                        </a>
                                    </div>
                                    <div class="menu-item px-3 my-0">
                                        <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="dark">
                                            <span class="menu-icon"><i class="ki-outline ki-moon fs-2"></i></span>
                                            <span class="menu-title">Tamno</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            @if(User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="d-flex align-items-stretch">
                                    <div class="topbar-item cursor-pointer symbol px-3 px-lg-4 symbol-30px" data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                                        <img src="/assets/media/avatars/blank.png" alt="User" />
                                    </div>
                                    <div class="menu-sub menu-sub-dropdown menu-rounded menu-gray-800 menu-state-bg fw-semibold py-4 w-250px" data-kt-menu="true">
                                        <div class="menu-item px-5">
                                            <form asp-controller="Account" asp-action="Logout" method="post">
                                                @Html.AntiForgeryToken()
                                                @* LOGEDIN USER *@
                                                <div class="menu-item px3">
                                                    <div class="menu-content d-flex align-items-center px-3">
                                                        <div class="d-flex flex-column">
                                                            <div class="fw-bold d-flex align-items-center fs-5">
                                                                @User.Identity.Name
                                                                @if (User.IsInRole("Admin"))
                                                                {
                                                                    <span class="badge badge-light-danger fw-bold fs-8 px-2 py-1 ms-2">Admin</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-light-primary fw-bold fs-8 px-2 py-1 ms-2">User</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="separator my-2"></div>
                                                <button type="submit" class="menu-link px-5 border-0 bg-transparent" style="cursor: pointer;">
                                                    <i class="ki-solid ki-exit-right fs-2x me-2"></i> Odjavi se
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <!-- END HEADER -->
                <!-- MAIN CONTENT -->
                <div class="content flex-row-fluid" id="kt_content">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </div>
                <!-- END MAIN CONTENT -->
                <!-- FOOTER -->
                <div class="footer py-4 d-flex flex-lg-column" id="kt_footer">
                    <div class="container-fluid d-flex flex-column flex-md-row align-items-center justify-content-between">
                        <div class="text-gray-900 order-2 order-md-1">
                            <span class="text-muted fw-semibold me-1">2026&copy;</span>
                            <a href="#" class="text-gray-800 text-hover-primary">Video katalog</a>
                        </div>
                    </div>
                </div>
                <!-- END FOOTER -->

            </div>
        </div>
    </div>
    <script src="/assets/plugins/global/plugins.bundle.js"></script>
    <script src="/assets/js/scripts.bundle.js"></script>
    <script>
        document.documentElement.setAttribute('data-bs-theme', 'light');
        try { localStorage.setItem('data-bs-theme', 'light'); } catch(e){}
    </script>
    <script src="~/js/toastr-handler.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
@if (TempData["FavoriteMessage"] != null)
{
    <script>
        showTempDataToastr("@TempData["FavoriteMessage"]", "@TempData["FavoriteType"]");
    </script>
}
<script src="~/js/confirmationSwalAlert.js"></script>

</html>