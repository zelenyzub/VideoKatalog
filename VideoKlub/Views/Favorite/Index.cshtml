@model IEnumerable<VideoKlub.Models.Favorite>

<div class="container-xxl mt-5">

    <div class="d-flex align-items-center mb-6">
        <i class="ki-duotone ki-heart fs-2 text-danger me-3"></i>
        <h2 class="fw-bold m-0">Omiljeni sadržaj</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info d-flex align-items-center">
            <i class="ki-duotone ki-information-5 fs-2 me-3"></i>
            <span>Nemate sačuvan omiljeni sadržaj.</span>
        </div>
    }
    else
    {
        <div class="row g-6">
            @foreach (var favorite in Model)
            {
                    <div class="col-xl-4 col-lg-6 col-md-6 col-sm-12">
                        <a asp-controller="Video" asp-action="Details" asp-route-id="@favorite.Video.Id" class="text-decoration-none">

                            <div class="card card-flush h-100 shadow-sm">

                                <!-- IMAGE -->
                                <div class="card-header p-0">
                                    <div class="overflow-hidden rounded-top">
                                        <img src="~/@favorite.Video.ImagePath"
                                             class="w-100"
                                             style="height:220px; object-fit:cover;"
                                             alt="@favorite.Video.Title" />
                                    </div>
                                </div>

                                <!-- BODY -->
                                    <div class="card-body d-flex flex-column">

                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div>
                                                <h5 class="fw-bold text-gray-800 mb-1">
                                                    @favorite.Video.Title
                                                </h5>
                                                <div class="text-muted fs-7">
                                                    Trajanje: @favorite.Video.Duration
                                                </div>
                                            </div>

                                            @if (favorite.Video.Category != null)
                                            {
                                                <span class="badge badge-light-primary">
                                                    @favorite.Video.Category.Name
                                                </span>
                                            }
                                        </div>

                                        <div class="mt-auto">
                                            <form asp-controller="Favorite"
                                                  asp-action="Toggle"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="videoId" value="@favorite.VideoId" />

                                                <button type="submit" class="btn btn-light-danger w-100">
                                                    <i class="ki-solid ki-heart fs-2x text-danger"></i> Ukloni iz omiljenih
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                            </div>
                        </a>
                    </div>
            }
        </div>
    }
</div>
